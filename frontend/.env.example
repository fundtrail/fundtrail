# The frontend's settings. Copy this file to frontend/.env.local (Next.js reads
# that file, not the repo root's .env) and fill in the values. Every variable
# here is public: Next.js builds NEXT_PUBLIC_ values into the browser bundle,
# so never put a secret in one.
#
# Real mode needs the first three. Without them, and without NEXT_PUBLIC_FAKE=1,
# every page shows an error naming the missing ones.

# The FastAPI backend's base URL, for example http://localhost:8000
NEXT_PUBLIC_API_URL=

# The Supabase project's URL, from the project's API settings
NEXT_PUBLIC_SUPABASE_URL=

# The project's publishable key (sb_publishable_...). New Supabase projects no longer issue an anon key; the name is kept.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to 1 to run on synthetic data with a fake sign-in and no backend. Leave unset in a deployment.
NEXT_PUBLIC_FAKE=
