# The backend's settings. Copy to .env and fill in; .env is git-ignored. Never commit a
# real key. Frontend variables live in frontend/.env.local, not here.

# The Anthropic API key the agent calls Claude with (read by Anthropic's SDK).
ANTHROPIC_API_KEY=

# Postgres: the Supabase session pooler's connection string (port 5432 on the pooler host).
DATABASE_URL=

# The Supabase project URL, for sign-in keys (its JWKS), Storage and Realtime.
SUPABASE_URL=
# The project's secret API key (sb_secret_...), used by the backend only, for Storage
# and Realtime. The name stays from the legacy service_role key it replaces.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: only for an older project that still signs user tokens with the shared JWT
# secret. Leave empty for a new project; tokens are checked against its JWKS.
SUPABASE_JWT_SECRET=

# Optional: how many grants the job worker runs at once (default 2).
WORKER_CONCURRENCY=
# Optional: "inline" runs the job worker inside the API process (default); "off" leaves
# it to its own process (python -m app.db.worker).
WORKER_MODE=

# The Google account file the Gmail and Drive checker signs in with (decision 0025).
GOOGLE_TOKEN_FILE=
# Tests only: a Drive folder link the Google smoke test reads.
FUNDTRAIL_SMOKE_DRIVE_FOLDER=
# Tests only: a Postgres server where the tests may create throwaway databases.
TEST_DATABASE_URL=
