# The backend's image (ruling 83). Built from the repo root so the image also carries
# data/samples, which the sample grants read; nothing else from the repo goes in (see
# Dockerfile.backend.dockerignore). Railway: root directory = repo root, Dockerfile
# path = Dockerfile.backend.
FROM python:3.12-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.11.31 /uv /usr/local/bin/uv

ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    FUNDTRAIL_DATA_DIR=/app/data

WORKDIR /app/backend

# Dependencies first, so a code change doesn't reinstall them.
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

COPY backend/ ./
COPY data/samples/ /app/data/samples/
RUN uv sync --locked --no-dev

ENV PATH="/app/.venv/bin:$PATH"

# Runs as an unprivileged user, not root.
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin fundtrail
USER 10001

# The Google account file, when its JSON is given in GOOGLE_TOKEN_JSON, is written to
# /tmp (readable by this user only) and named by GOOGLE_TOKEN_FILE; nothing is printed,
# and the JSON is dropped from the environment before the API starts on $PORT.
CMD ["sh", "-c", "if [ -n \"$GOOGLE_TOKEN_JSON\" ]; then umask 077; printf '%s' \"$GOOGLE_TOKEN_JSON\" > /tmp/google-token.json; export GOOGLE_TOKEN_FILE=/tmp/google-token.json; fi; unset GOOGLE_TOKEN_JSON; exec python -m uvicorn app.main:app --host 0.0.0.0 --port \"${PORT:-8000}\""]
